<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bluetooth moderne (Android 12+ / SDK 31+) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <!-- Notification du foreground service (Android 13+ / SDK 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground Service de type connectedDevice (Android 14+ / SDK 34+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- Exclusion de l'optimisation de batterie (écran éteint) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Mise à jour in-app de l'APK (release GitHub nightly) + install de l'APK téléchargé -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.DomyosBridge"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- foregroundServiceType="connectedDevice" : obligatoire sous Android 14/15/16
             pour un service BLE persistant. Ne jamais appeler startForeground()
             avant d'avoir vérifié BLUETOOTH_CONNECT / BLUETOOTH_ADVERTISE. -->
        <service
            android:name=".BleBridgeService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Partage des logs (bridge-logs.txt) et install de l'APK téléchargé -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.domyos500b.bridge.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
